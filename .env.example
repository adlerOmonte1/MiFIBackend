# Copia este archivo como .env y completa los valores reales.
# .env está en .gitignore — nunca commitear credenciales reales.

# --- Base de datos (Supabase Postgres) — Fase 2.2 ---
DATABASE_URL=

# --- Autenticación propia (D-01, D-02, D-03) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Cifrado de tokens de Gmail (D-06, RF-24) — 32 bytes en base64 para AES-256-GCM ---
ENCRYPTION_KEY=

# --- Google Cloud Vision API (F3 — OCR, RF-16/17) ---
# Ruta local al JSON de la cuenta de servicio (dev). En Render, usar
# GOOGLE_VISION_CREDENTIALS_JSON con el contenido completo del JSON en su lugar.
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
# GOOGLE_VISION_CREDENTIALS_JSON=

# --- Gmail API OAuth 2.0 (F4 — GML-01/02, RF-23) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# --- Servidor ---
PORT=3000
